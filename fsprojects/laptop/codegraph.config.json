{
  "name": "laptop",
  "kind": "filesystem",
  "host": "laptop",
  "roots": [
    "/home/kirill/.config",
    "/home/kirill/Documents/Projects",
    "/etc/systemd/system"
  ],
  "ignore": [
    "**/node_modules", "**/.git", "**/target", "**/dist", "**/build",
    "**/.svelte-kit", "**/.next", "**/.cache", "**/__pycache__", "**/.venv",
    "**/venv", "**/.ruff_cache", "**/vendor", "**/.smart-env", "**/.obsidian",
    "**/coverage", "**/.turbo", "**/.pnpm-store", "**/go/pkg", "**/snap",
    "**/.mozilla", "**/Cache", "**/CachedData", "**/logs", "**/.npm",
    "**/Code/User/History", "**/Code/User/workspaceStorage",
    "**/Code/User/globalStorage", "**/Code/logs", "**/Code/Cache*",
    "**/.config/discord", "**/.config/vesktop", "**/.config/Electron"
  ],
  "includeExt": [
    "md", "mdx",
    "service", "timer", "socket", "target", "mount", "path",
    "conf", "ini", "config", "env", "rules", "hook",
    "toml", "yaml", "yml",
    "sh", "bash", "zsh", "fish", "nix"
  ],
  "includeName": ["Dockerfile", "docker-compose*", "*.desktop"],
  "maxFileSize": 1048576,
  "staleDays": 90
}
